<odoo>

    <record id="view_autoproctor_report_wizard_form" model="ir.ui.view">
        <field name="name">survey.autoproctor.report.wizard.form</field>
        <field name="model">survey.autoproctor.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Proctoring Report">
                <sheet>
                    <separator string="Proctoring Result"/>
                    <field name="report_html" nolabel="1"/>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>