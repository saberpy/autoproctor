<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_survey_view_form_autoproctor" model="ir.ui.view">
        <field name="name">survey.survey.view.form.autoproctor</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']/group[@name='options']" position="inside">
                <group string="Proctoring" name="autoproctor">
                    <field name="autoproctor_configured" invisible="1"/>
                    <field name="autoproctor_enabled"
                           invisible="survey_type == 'live_session'"/>
                    <div class="alert alert-warning mb-2"
                         role="alert"
                         invisible="not autoproctor_enabled or autoproctor_configured">
                        AutoProctor credentials are missing. Configure them in General Settings before sharing this survey.
                    </div>
                    <field name="autoproctor_audio"
                           invisible="not autoproctor_enabled"/>
                    <field name="autoproctor_num_humans"
                           invisible="not autoproctor_enabled"/>
                    <field name="autoproctor_tab_switch"
                           invisible="not autoproctor_enabled"/>
                    <field name="autoproctor_photos_at_random"
                           invisible="not autoproctor_enabled"/>
                    
                    <field name="stop_survey_with_autoproctor_report"
                           invisible="not autoproctor_enabled"/>
                    
                    <field name="stop_score" invisible="not stop_survey_with_autoproctor_report"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
