<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_autoproctor" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.autoproctor</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="autoproctor_credentials"
                         string="AutoProctor"
                         help="Configure the tenant credentials used for proctored surveys."
                         groups="base.group_system">
                    <div class="content-group mt16">
                        <div class="row mt8">
                            <label for="autoproctor_client_id" class="col-lg-3 o_light_label"/>
                            <field name="autoproctor_client_id" class="oe_inline"/>
                        </div>
                        <div class="row mt8">
                            <label for="autoproctor_client_secret" class="col-lg-3 o_light_label"/>
                            <field name="autoproctor_client_secret"
                                   password="True"
                                   class="oe_inline"/>
                        </div>
                        <div class="text-muted mt8">
                            The client secret is used only by the Odoo backend to generate HMAC-SHA256 hashes and is never sent to survey pages.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
